# Copy to config.env and fill in. All gcp/ scripts source this file.
#   cp eval/gcp/config.env.example eval/gcp/config.env

# --- GCP project / location -------------------------------------------------
PROJECT_ID=your-gcp-project
REGION=us-central1
ZONE=us-central1-a

# --- Artifact Registry (Docker image) --------------------------------------
AR_REPO=e2a-eval
IMAGE="${REGION}-docker.pkg.dev/${PROJECT_ID}/${AR_REPO}/e2a-eval:latest"

# --- Results bucket (GCS) ---------------------------------------------------
BUCKET=your-eval-results-bucket

# --- Build reproducibility --------------------------------------------------
# Pin the piguard source commit so the heuristics engine is fixed for the paper.
# Pinned to e2a@d214a50 (#292, 2026-06-24). Bump deliberately when re-evaluating.
E2A_REF=d214a5003a7b93352e3d3cdfbc74daf70d354b19
# Bake the three HF model weights into the image (1 = network-independent runs).
BAKE_MODELS=1

# --- VM ---------------------------------------------------------------------
VM_NAME=e2a-eval-runner
# e2-standard-4 (4 vCPU / 16GB) is plenty for CPU inference of the small models.
MACHINE_TYPE=e2-standard-4
# 1 = the VM deletes itself after the run finishes (cost safety).
DELETE_SELF=1

# --- Detectors to run -------------------------------------------------------
# Space-separated. hf:* run locally in the container; the rest need API keys
# (stored in Secret Manager, see setup.sh).
DETECTORS="piguard hf:protectai/deberta-v3-base-prompt-injection-v2 hf:leolee99/InjecGuard hf:fmops/distilbert-prompt-injection gemini lakera"
